# `npm run dev` only. Requests go to /api on localhost and the Vite proxy forwards
# them to the Laravel server (see vite.config.js) — this sidesteps the server's
# untrusted SSL certificate and CORS during development.
VITE_API_URL=/api/
VITE_API_PROXY_TARGET=https://154.57.211.187/intellivex/public

# Uploaded images: replaces the API's unreachable image host. /storage is proxied by Vite (vite.config.js).
VITE_MEDIA_URL=/storage
