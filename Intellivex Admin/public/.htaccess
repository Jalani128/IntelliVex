# Single-page app fallback (Apache): the admin routes on the client, so a refresh
# on /admin/services must serve index.html instead of a 404. Real files still load.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
