# Laravel API base URL for the admin endpoints (e.g. http://localhost/api/admin)
VITE_API_BASE_URL=http://localhost/api/admin
# true = in-memory mock data, false = real Laravel API
VITE_USE_MOCK=true
# Login: true = mock accounts, false = POST /login, GET /me on the API
VITE_USE_MOCK_AUTH=true
# Public website origin, for "View on website" links (e.g. https://intellivex.com)
VITE_SITE_URL=http://localhost:5173
# Uploaded images: public URL of Laravel's storage folder (unset = use the URLs the API returns)
VITE_MEDIA_URL=
