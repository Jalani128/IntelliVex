# `npm run build`: real Laravel API and real login. Without these the build falls
# back to mock data and the hardcoded mock account (services/admin/config.js).
VITE_USE_MOCK=false
VITE_USE_MOCK_AUTH=false
VITE_API_BASE_URL=https://154.57.211.187/intellivex/public/api/admin

# Public website origin, for "View on website" links
VITE_SITE_URL=https://theintellivex.com

# Uploaded images: public URL of Laravel's storage folder
VITE_MEDIA_URL=https://154.57.211.187/intellivex/public/storage
